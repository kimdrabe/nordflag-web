---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt"
  description="Sie haben ein Projekt im Kopf? Lassen Sie uns darüber sprechen. Kontaktieren Sie Nordflag für ein unverbindliches Erstgespräch."
>
  <section class="pt-32 pb-16 md:pt-40 md:pb-20 bg-gradient-to-b from-nord-50/50 to-white">
    <div class="container-nord text-center">
      <span class="inline-block text-nord-500 font-medium text-sm uppercase tracking-widest mb-3">Kontakt</span>
      <h1 class="section-title mb-4">Lassen Sie uns reden</h1>
      <p class="section-subtitle mx-auto">
        Sie haben ein Projekt im Kopf oder Fragen zu unseren Leistungen? Dann schreiben Sie uns – wir melden uns innerhalb von 24 Stunden bei Ihnen.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-nord">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-20">
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-display font-bold text-gray-900 mb-6">Kontaktinformationen</h2>
          <ul class="space-y-6">
            <li class="flex gap-4">
              <div class="w-12 h-12 rounded-xl bg-nord-50 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A66FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-gray-900 text-sm mb-1">E-Mail</h3>
                <a href="mailto:hallo@nordflag.de" class="text-nord-500 hover:text-nord-600 transition-colors">hallo@nordflag.de</a>
              </div>
            </li>
            <li class="flex gap-4">
              <div class="w-12 h-12 rounded-xl bg-nord-50 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A66FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-gray-900 text-sm mb-1">Standort</h3>
                <p class="text-gray-600 text-sm">Lübeck, Deutschland</p>
              </div>
            </li>
            <li class="flex gap-4">
              <div class="w-12 h-12 rounded-xl bg-nord-50 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A66FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-gray-900 text-sm mb-1">Telefon</h3>
                <a href="tel:+494510000000" class="text-nord-500 hover:text-nord-600 transition-colors">+49 451 0000000</a>
              </div>
            </li>
          </ul>

          <div class="mt-10 p-6 rounded-2xl bg-gray-50 border border-gray-100">
            <h3 class="font-display font-semibold text-gray-900 mb-2">Schnelle Antwort garantiert</h3>
            <p class="text-sm text-gray-600">Wir antworten innerhalb von 24 Stunden. Meistens sogar schneller.</p>
          </div>
        </div>

        <div class="lg:col-span-3">
          <form class="space-y-6" data-netlify="true" name="kontakt">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-2">Name *</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-nord-500 focus:ring-2 focus:ring-nord-500/20 outline-none transition-all text-sm" placeholder="Ihr Name" />
              </div>
              <div>
                <label for="company" class="block text-sm font-medium text-gray-700 mb-2">Unternehmen</label>
                <input type="text" id="company" name="company" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-nord-500 focus:ring-2 focus:ring-nord-500/20 outline-none transition-all text-sm" placeholder="Ihr Unternehmen" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">E-Mail *</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-nord-500 focus:ring-2 focus:ring-nord-500/20 outline-none transition-all text-sm" placeholder="ihre@email.de" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">Telefon</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-nord-500 focus:ring-2 focus:ring-nord-500/20 outline-none transition-all text-sm" placeholder="+49 451 0000000" />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Ihre Nachricht *</label>
              <textarea id="message" name="message" required rows="5" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-nord-500 focus:ring-2 focus:ring-nord-500/20 outline-none transition-all text-sm resize-y" placeholder="Erzählen Sie uns von Ihrem Projekt..."></textarea>
            </div>
            <button type="submit" class="btn-primary w-full text-base py-4">
              Nachricht senden
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
