---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const leistungen = await getCollection('leistungen');
const sorted = leistungen.sort((a, b) => a.data.order - b.data.order);
---

<section class="section-padding bg-gray-50/50">
  <div class="container-nord">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-nord-500 font-medium text-sm uppercase tracking-widest mb-3">Leistungen</span>
      <h2 class="section-title mb-4">Was wir für Sie tun können</h2>
      <p class="section-subtitle mx-auto">
        Von der ersten Idee bis zur fertigen Webseite – wir begleiten Sie durch den gesamten Prozess. Mit klarer Kommunikation, handwerklicher Präzision und einem Auge fürs Detail.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {sorted.map((item, i) => (
        <article class="group card-hover animate-on-scroll opacity-0 translate-y-4 transition-all duration-700" style={`transition-delay: ${i * 100}ms`}>
          <div class="w-12 h-12 rounded-xl bg-nord-50 flex items-center justify-center mb-5 group-hover:bg-nord-500 transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-nord-500 group-hover:text-white transition-colors duration-300">
              {item.data.icon === 'globe' && <>
                <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </>}
              {item.data.icon === 'layout' && <>
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>
              </>}
              {item.data.icon === 'monitor' && <>
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
              </>}
              {item.data.icon === 'refresh-cw' && <>
                <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
              </>}
              {item.data.icon === 'tools' && <>
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
              </>}
              {item.data.icon === 'search' && <>
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </>}
            </svg>
          </div>
          <h3 class="text-xl font-display font-semibold text-gray-900 mb-3">{item.data.title}</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">{item.data.description}</p>
          <a href={`${base}leistungen`} class="inline-flex items-center gap-1 text-nord-500 text-sm font-medium hover:gap-2 transition-all">
            Mehr erfahren
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
